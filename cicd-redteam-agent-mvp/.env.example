# Copy this file to .env next to pyproject.toml. Never commit real values.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# LITELLM_API_KEY=
# GH_TOKEN=  # optional read-only GitHub observation; Metadata/Actions/Issues/Pull requests/Administration: read
# AWS_PROFILE=  # optional for --observe-aws; requires iam:GetRole and iam:GetOpenIDConnectProvider

# Explicit P0 live GitHub acceptance inputs. These tests are excluded from the default pytest suite.
# Use a controlled repository and a fine-grained read-only token; never commit real values.
# CICD_LIVE_GITHUB_REPOSITORY=owner/repository
# CICD_LIVE_GITHUB_TOKEN=
# CICD_LIVE_GITHUB_RUN_ID=
# CICD_LIVE_GITHUB_RERUN_ID=          # optional: existing run with run_attempt > 1
# CICD_LIVE_GITHUB_MISSING_RUN_ID=    # optional: known-nonexistent run ID for live 404 classification

# Explicit P1 live event-principal acceptance inputs. Never commit real token values.
# CICD_P1_LIVE_GITHUB_REPOSITORY=owner/repository
# CICD_P1_LIVE_GITHUB_TOKEN=
# CICD_P1_LIVE_GITHUB_ACTOR_LOGIN=
# CICD_P1_LIVE_GITHUB_ACTOR_ID=
# CICD_P1_LIVE_GITHUB_ISSUE_NUMBER=
# CICD_P1_LIVE_GITHUB_COMMENT_ID=
# CICD_P1_LIVE_GITHUB_ISSUE_COMMENT_RUN_ID=
# CICD_P1_LIVE_GITHUB_PULL_NUMBER=
# CICD_P1_LIVE_GITHUB_PULL_REQUEST_RUN_ID=
# CICD_P1_LIVE_GITHUB_LABEL_RUN_ID=
# CICD_P1_LIVE_GITHUB_REVIEW_ID=
# CICD_P1_LIVE_GITHUB_REVIEW_RUN_ID=
# CICD_P1_LIVE_GITHUB_REVIEW_COMMENT_ID=
# CICD_P1_LIVE_GITHUB_REVIEW_COMMENT_RUN_ID=

# Explicit P2 live status/dependency acceptance inputs. Never commit real token values.
# CICD_P2_LIVE_GITHUB_REPOSITORY=owner/repository
# CICD_P2_LIVE_GITHUB_TOKEN=
# CICD_P2_LIVE_GITHUB_STATUS_RUN_ID=
# CICD_P2_LIVE_GITHUB_CANCEL_RUN_ID=
