{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Strix",
          "informationUri": "https://strix.ai",
          "rules": [
            {
              "id": "strix-coverage/reconnaissance-and-attack-surface-mapping",
              "name": "Reconnaissance and Attack Surface Mapping",
              "shortDescription": {
                "text": "Coverage: Reconnaissance and Attack Surface Mapping"
              },
              "fullDescription": {
                "text": "Coverage of Reconnaissance and Attack Surface Mapping across the assessed attack surface."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "help": {
                "text": "Coverage of Reconnaissance and Attack Surface Mapping across the assessed attack surface.",
                "markdown": "Coverage of Reconnaissance and Attack Surface Mapping across the assessed attack surface."
              },
              "properties": {
                "tags": [
                  "coverage"
                ]
              }
            },
            {
              "id": "strix-coverage/stored-xss-in-feedback-contact-form",
              "name": "Stored XSS in feedback/contact form",
              "shortDescription": {
                "text": "Coverage: Stored XSS in feedback/contact form"
              },
              "fullDescription": {
                "text": "Coverage of Stored XSS in feedback/contact form across the assessed attack surface."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "help": {
                "text": "Coverage of Stored XSS in feedback/contact form across the assessed attack surface.",
                "markdown": "Coverage of Stored XSS in feedback/contact form across the assessed attack surface."
              },
              "properties": {
                "tags": [
                  "coverage"
                ]
              }
            }
          ],
          "version": "1.6.1"
        }
      },
      "results": [
        {
          "ruleId": "strix-coverage/reconnaissance-and-attack-surface-mapping",
          "ruleIndex": 0,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Reconnaissance and Attack Surface Mapping — No issue identified: Complete Application Reconnaissance\n\nComprehensive black-box reconnaissance completed. Mapped 100+ API endpoints, 50+ frontend routes, identified technology stack (Express.js, Angular, Node.js), security headers, authentication mechanisms, and deployment context. Complete endpoint inventory with HTTP methods documented. Threat model established with attack surface analysis and attacker profiles identified. All reconnaissance findings documented in shared notes for follow-up vulnerability testing by specialist agents.\""
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "Complete Application Reconnaissance"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "no_issue_found",
              "risk_area": "Reconnaissance and Attack Surface Mapping",
              "surface": "Complete Application Reconnaissance",
              "recorded_by": "Reconnaissance Agent",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/stored-xss-in-feedback-contact-form",
          "ruleIndex": 1,
          "kind": "open",
          "level": "none",
          "message": {
            "text": "Stored XSS in feedback/contact form — Requires further review: /feedback endpoint\n\nFeedback endpoint accepts POST submissions and stores them in /api/Feedbacks. API response contains existing feedback entries with HTML markup like <b> tags being preserved, indicating lack of HTML escaping. Multiple XSS payloads (img/svg/script tags) were submitted successfully (HTTP 200), but storage verification failed due to endpoint behavior. Requires client-side rendering inspection to confirm execution."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "/feedback endpoint"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "needs_follow_up",
              "risk_area": "Stored XSS in feedback/contact form",
              "surface": "/feedback endpoint",
              "recorded_by": "Cross-Site Scripting (XSS) Testing Agent",
              "source": "agent_reported"
            }
          }
        }
      ],
      "invocations": [
        {
          "executionSuccessful": false,
          "toolExecutionNotifications": [
            {
              "level": "warning",
              "message": {
                "text": "4 agent(s) did not finish cleanly (Business Logic & CSRF Testing Agent, Cross-Site Scripting (XSS) Testing Agent, File Upload & RCE Testing Agent, Information Disclosure & XXE Testing Agent); any surface they held is under-covered."
              }
            }
          ]
        }
      ]
    }
  ]
}
