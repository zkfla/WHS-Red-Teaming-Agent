        {
          "ruleId": "vuln-0001",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Unrestricted File Upload on /file-upload Endpoint\n\nThe `/file-upload` endpoint accepts file uploads without any validation of file extensions, MIME types, or content. PHP, executable, and other dangerous file types are accepted and stored without restriction."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "SECURITY.md"
                }
              }
            },
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "http://host.docker.internal:3100",
                  "kind": "resource"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "5e5df8c90433f7345a2a50c8ddff82e076373cf1acf233edfd84922e3b49a26f"
          },
          "properties": {
            "security-severity": "9.8",
            "strix_vuln_class_hash": "fa903f2504fb14f3229db37730aed7515c92b517f1aa0420b08c0c1889931276",
            "synthetic_location": true,
            "strix": {
              "id": "vuln-0001",
              "severity": "critical",
              "cvss": 9.8,
              "timestamp": "2026-09-04 15:05:49 UTC",
              "target": "http://host.docker.internal:3100",
              "impact": "Arbitrary file upload enables remote code execution if uploaded files are accessible and executed by the server. Malicious PHP shells, executables, and other code can be deployed to the application server.",
              "technical_analysis": "The endpoint at POST `/file-upload` processes multipart form uploads with no validation layer. Testing revealed that:\n1. PHP files (shell.php) are accepted with status 204\n2. Executable files (.exe) bypass any extension checks\n3. Double extensions (.jpg.php) are accepted\n4. Content-Type headers are not validated - image/jpeg MIME can wrap PHP code\n5. No authentication required\n6. Path traversal sequences in filenames (../../) are accepted without sanitization\n7. Large files (>100KB) bypass size restrictions on this endpoint",
              "remediation_steps": "1. Implement whitelist-based file extension validation on the server side (not client-side)\n2. Validate MIME types by inspecting file magic bytes, not Content-Type headers\n3. Store uploaded files outside the web root or in a directory with no execute permissions\n4. Rename uploaded files with a random UUID to prevent direct access\n5. Implement file size limits\n6. Add authentication requirement to file upload endpoints\n7. Scan uploaded files with antivirus/malware detection\n8. Disable script execution in upload directories via web server configuration",
              "counterevidence": "No file type validation observed at transport layer. No WAF/filtering detected. No authentication requirement enforced. Direct acceptance of all tested file types indicates complete lack of upload restrictions. Testing showed consistent 204 responses regardless of file extension or content.",
              "confidence": "high",
              "severity_change_conditions": "Confirmation that uploaded PHP files execute on the server (not just stored) would confirm RCE. Discovery of actual location where files are stored and confirmed execution would raise to CRITICAL.",
              "poc": {
                "description": "1. Craft a PHP webshell payload: `<?php system($_GET[\"cmd\"]); ?>`\n2. Create multipart POST request to `/file-upload` with file parameter\n3. Upload with filename `shell.php` and Content-Type `image/jpeg`\n4. Server responds with 204 (success)\n5. Locate uploaded file in public directory (e.g., /assets/public/images/uploads/)\n6. Access PHP shell via HTTP to execute arbitrary commands",
                "script_available": true
              }
            }
          }
        },
        {
          "ruleId": "strix-coverage/http-method-tampering",
          "ruleIndex": 1,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "HTTP Method Tampering — No issue identified: HTTP Method Tampering across API\n\nTested POST, PUT, DELETE, PATCH on read-only endpoints /rest/admin/application-configuration, /rest/user/whoami, /rest/products/search. Unsupported methods returned HTTP 500 or 405. GET and HEAD methods return proper responses. Proper method handling confirmed."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "HTTP Method Tampering across API"
                }
              ]
            }
          ],
          "properties": {
