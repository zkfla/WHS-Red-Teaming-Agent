          "rules": [
            {
              "id": "CWE-89",
              "name": "SQL Injection Authentication Bypass in Login Form",
              "shortDescription": {
                "text": "SQL Injection Authentication Bypass in Login Form"
              },
              "fullDescription": {
                "text": "The login endpoint is vulnerable to SQL injection in the email parameter, allowing attackers to bypass authentication and log in as any user without knowing their password. The vulnerability exists due to improper input validation or parameterization of the SQL query."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "help": {
                "text": "The login endpoint is vulnerable to SQL injection in the email parameter, allowing attackers to bypass authentication and log in as any user without knowing their password. The vulnerability exists due to improper input validation or parameterization of the SQL query.\n\nAn attacker can bypass authentication and gain unauthorized access to user accounts, including administrative accounts. This allows complete compromise of the application and access to all user data.\n\nImplement parameterized queries or prepared statements for all database operations. The login query should use parameter binding to separate SQL code from user input. Example: Use query parameters like `SELECT * FROM users WHERE email = ? AND password = ?` and pass email and password as separate parameters to the database driver. Additionally, implement input validation to reject email addresses containing SQL keywords or special characters, and implement rate limiting on failed login attempts to mitigate brute force attacks.",
                "markdown": "The login endpoint is vulnerable to SQL injection in the email parameter, allowing attackers to bypass authentication and log in as any user without knowing their password. The vulnerability exists due to improper input validation or parameterization of the SQL query.\n\nAn attacker can bypass authentication and gain unauthorized access to user accounts, including administrative accounts. This allows complete compromise of the application and access to all user data.\n\nImplement parameterized queries or prepared statements for all database operations. The login query should use parameter binding to separate SQL code from user input. Example: Use query parameters like `SELECT * FROM users WHERE email = ? AND password = ?` and pass email and password as separate parameters to the database driver. Additionally, implement input validation to reject email addresses containing SQL keywords or special characters, and implement rate limiting on failed login attempts to mitigate brute force attacks."
              },
              "properties": {
                "security-severity": "9.8",
                "tags": [
                  "security",
                  "CWE-89",
                  "stride:T"
                ]
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/89.html"
            },
