        {
          "ruleId": "CWE-89",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "SQL Injection in Login Endpoint Authentication Bypass\n\nThe `/rest/user/login` endpoint is vulnerable to SQL injection in the email parameter, allowing unauthenticated attackers to bypass authentication and gain admin access without valid credentials."
          },
          "locations": [
