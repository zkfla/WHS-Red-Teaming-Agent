          "rules": [
            {
              "id": "CWE-89",
              "name": "SQL Injection in Login Endpoint Authentication Bypass",
              "shortDescription": {
                "text": "SQL Injection in Login Endpoint Authentication Bypass"
              },
              "fullDescription": {
                "text": "The `/rest/user/login` endpoint is vulnerable to SQL injection in the email parameter, allowing unauthenticated attackers to bypass authentication and gain admin access without valid credentials."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "help": {
                "text": "The `/rest/user/login` endpoint is vulnerable to SQL injection in the email parameter, allowing unauthenticated attackers to bypass authentication and gain admin access without valid credentials.\n\nAn unauthenticated attacker can bypass the login mechanism entirely, obtaining a valid admin JWT token without knowing any credentials. This grants full administrative access to the application, including user management, data access, and system configuration.\n\nUse parameterized queries or prepared statements for all SQL operations. In Node.js, use placeholders instead of string concatenation: db.query('SELECT * FROM Users WHERE email = ? AND password = ?', [email, password]). Implement input validation to reject SQL syntax characters in email fields. Use ORM frameworks that enforce parameterized queries by default.",
                "markdown": "The `/rest/user/login` endpoint is vulnerable to SQL injection in the email parameter, allowing unauthenticated attackers to bypass authentication and gain admin access without valid credentials.\n\nAn unauthenticated attacker can bypass the login mechanism entirely, obtaining a valid admin JWT token without knowing any credentials. This grants full administrative access to the application, including user management, data access, and system configuration.\n\nUse parameterized queries or prepared statements for all SQL operations. In Node.js, use placeholders instead of string concatenation: db.query('SELECT * FROM Users WHERE email = ? AND password = ?', [email, password]). Implement input validation to reject SQL syntax characters in email fields. Use ORM frameworks that enforce parameterized queries by default."
              },
              "properties": {
                "security-severity": "9.1",
                "tags": [
                  "security",
                  "CWE-89",
                  "stride:T"
                ]
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/89.html"
