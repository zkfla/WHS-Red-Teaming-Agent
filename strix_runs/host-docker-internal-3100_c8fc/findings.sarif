          "partialFingerprints": {
            "primaryLocationLineHash": "a61829a230edd7511efaa6af481a0e5556654bc6bc27fcc968b267f5ed4ddae5"
          },
          "properties": {
            "security-severity": "9.1",
            "strix_vuln_class_hash": "091274e2ad40f12c26f944cb00be2712c536b9e81137676e98311bc2ccf04d16",
            "synthetic_location": true,
            "strix": {
              "id": "vuln-0001",
              "severity": "critical",
              "cvss": 9.1,
              "timestamp": "2026-09-04 15:17:16 UTC",
              "target": "http://host.docker.internal:3100",
              "endpoint": "/rest/user/login",
              "method": "POST",
              "cwe": "CWE-89",
              "impact": "An unauthenticated attacker can bypass the login mechanism entirely, obtaining a valid admin JWT token without knowing any credentials. This grants full administrative access to the application, including user management, data access, and system configuration.",
              "technical_analysis": "The login endpoint constructs a SQL query using string concatenation with unsanitized user input from the email parameter. The query appears to be: SELECT * FROM Users WHERE email = '[email]' AND password = '[password]'. By injecting ' OR 1=1 --, the attacker modifies the WHERE clause to return the first user in the database (the admin account with id=1). The application then generates a JWT token for this admin user without verifying the password.",
              "remediation_steps": "Use parameterized queries or prepared statements for all SQL operations. In Node.js, use placeholders instead of string concatenation: db.query('SELECT * FROM Users WHERE email = ? AND password = ?', [email, password]). Implement input validation to reject SQL syntax characters in email fields. Use ORM frameworks that enforce parameterized queries by default.",
              "counterevidence": "No input validation, WAF, or SQL parameterization found on login endpoint. Application directly uses user-supplied email in SQL query construction. Injection works without pre-existing credentials. No rate limiting or login throttling observed.",
              "confidence": "high",
              "severity_change_conditions": "Confirmation this is internet-facing deployment maintains critical severity. Implementation of input validation or query parameterization would eliminate the vulnerability.",
              "poc": {
                "description": "1. Send a POST request to /rest/user/login with email parameter containing SQL injection payload ' OR 1=1 -- and any password value. 2. The server responds with HTTP 200 and a valid JWT token for the admin user. 3. The JWT token contains user data including role=admin and can be used to authenticate as the admin user. 4. Use the token to access admin-only endpoints.",
                "script_available": true
              }
            }
          }
        },
