          "ruleId": "strix-coverage/business-logic-negative-quantity-validation",
          "ruleIndex": 1,
          "kind": "open",
          "level": "none",
          "message": {
            "text": "Business Logic - Negative Quantity Validation — Requires further review: /api/BasketItems - Negative Quantity Abuse\n\nAPI endpoint /api/BasketItems returns 500 errors with \"WHERE parameter ProductId has invalid undefined value\". Could not fully test negative quantity abuse due to API contract issues. The API appears to expect a specific request format not yet reverse-engineered from working traffic. This requires either source code inspection or capturing actual browser-generated requests to understand the correct payload structure."
          },
          "locations": [
