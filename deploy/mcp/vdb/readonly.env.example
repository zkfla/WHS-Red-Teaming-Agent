# Operator: replace command/policy path. Do not start upstream mcp-server-vdb.
REDTEAM_MCP_VDB_READONLY_KIND=analysis
REDTEAM_MCP_VDB_READONLY_TRANSPORT=stdio
REDTEAM_MCP_VDB_READONLY_COMMAND=/absolute/isolated-vdb-venv/bin/python
REDTEAM_MCP_VDB_READONLY_ARGS_JSON='["-m","redteam.capability.servers.vdb_readonly","--policy","/absolute/vdb-policy.json"]'
REDTEAM_MCP_VDB_READONLY_PROFILE=vdb_readonly
REDTEAM_MCP_VDB_READONLY_VDB_ASSET_REF=vdb-knowledge
REDTEAM_MCP_VDB_READONLY_RISK_LEVEL=medium
REDTEAM_MCP_VDB_READONLY_ALLOWED_TOOLS_JSON='["vdb_status","search_by_cve","search_by_purl_like"]'
REDTEAM_MCP_VDB_READONLY_TOOL_OPERATIONS_JSON='{"vdb_status":["response_analysis"],"search_by_cve":["static_analysis"],"search_by_purl_like":["static_analysis"]}'
REDTEAM_MCP_VDB_READONLY_MAX_CONCURRENCY=1
REDTEAM_MCP_VDB_READONLY_MAX_OUTPUT_BYTES=262144
