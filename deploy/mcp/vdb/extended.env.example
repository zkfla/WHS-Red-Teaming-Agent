# Opt-in extension; do not load simultaneously with the basic profile for the same ToolIds.
# Operator must edit the interpreter/policy paths and provision matching engagement/run.
REDTEAM_MCP_VDB_EXTENDED_KIND=analysis
REDTEAM_MCP_VDB_EXTENDED_TRANSPORT=stdio
REDTEAM_MCP_VDB_EXTENDED_COMMAND=/absolute/isolated-vdb-venv/bin/python
REDTEAM_MCP_VDB_EXTENDED_ARGS_JSON='["-m","redteam.capability.servers.vdb_readonly","--policy","/absolute/vdb-extended-policy.json","--profile","vdb_readonly_extended"]'
REDTEAM_MCP_VDB_EXTENDED_PROFILE=vdb_readonly_extended
REDTEAM_MCP_VDB_EXTENDED_VDB_ASSET_REF=vdb-knowledge
REDTEAM_MCP_VDB_EXTENDED_RISK_LEVEL=medium
REDTEAM_MCP_VDB_EXTENDED_ALLOWED_TOOLS_JSON='["vdb_status","search_by_cve","search_by_purl_like","search_by_ghsa","search_by_cpe_like","search_packages","search_sbom"]'
REDTEAM_MCP_VDB_EXTENDED_TOOL_OPERATIONS_JSON='{"vdb_status":["response_analysis"],"search_by_cve":["static_analysis"],"search_by_purl_like":["static_analysis"],"search_by_ghsa":["static_analysis"],"search_by_cpe_like":["static_analysis"],"search_packages":["static_analysis"],"search_sbom":["static_analysis"]}'
REDTEAM_MCP_VDB_EXTENDED_MAX_CONCURRENCY=1
# For independent lookups, also raise policy max_concurrent_lookups (maximum 8).
REDTEAM_MCP_VDB_EXTENDED_MAX_OUTPUT_BYTES=262144
