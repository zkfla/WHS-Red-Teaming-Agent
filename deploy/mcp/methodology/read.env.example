# Operator provisioning must succeed before using this profile.
# Do not enable together with workspace-read (identical ToolIds).
# This example deliberately does not overwrite existing server-id lists.
REDTEAM_MCP_METHODOLOGY_READ_KIND='analysis'
REDTEAM_MCP_METHODOLOGY_READ_TRANSPORT='stdio'
REDTEAM_MCP_METHODOLOGY_READ_COMMAND='/absolute/path/to/repository/.venv/bin/python'
REDTEAM_MCP_METHODOLOGY_READ_ARGS_JSON='["-m","redteam.capability.servers.workspace","--policy","/absolute/path/to/reference-policy.json","--mode","read"]'
REDTEAM_MCP_METHODOLOGY_READ_PROFILE='workspace_read'
REDTEAM_MCP_METHODOLOGY_READ_WORKSPACE_ASSET_REF='methodology-guides'
REDTEAM_MCP_METHODOLOGY_READ_RISK_LEVEL='medium'
REDTEAM_MCP_METHODOLOGY_READ_ALLOWED_TOOLS_JSON='["list_directory","read_file","search_files"]'
REDTEAM_MCP_METHODOLOGY_READ_TOOL_OPERATIONS_JSON='{"list_directory":["directory_list"],"read_file":["file_read"],"search_files":["file_search"]}'
REDTEAM_MCP_METHODOLOGY_READ_MAX_CONCURRENCY='1'
REDTEAM_MCP_METHODOLOGY_READ_MAX_OUTPUT_BYTES='1048576'
