# Use ONE read server for the composite parent Workspace and reference data.
# Replace operator-owned paths/Asset. Does not change existing server lists.
REDTEAM_MCP_WORKSPACE_READ_KIND='analysis'
REDTEAM_MCP_WORKSPACE_READ_TRANSPORT='stdio'
REDTEAM_MCP_WORKSPACE_READ_COMMAND='/absolute/path/to/repository/.venv/bin/python'
REDTEAM_MCP_WORKSPACE_READ_ARGS_JSON='["-m","redteam.capability.servers.workspace","--policy","/absolute/path/to/workspace-policy.json","--mode","read"]'
REDTEAM_MCP_WORKSPACE_READ_PROFILE='workspace_read'
REDTEAM_MCP_WORKSPACE_READ_WORKSPACE_ASSET_REF='workspace-methodology'
REDTEAM_MCP_WORKSPACE_READ_RISK_LEVEL='medium'
REDTEAM_MCP_WORKSPACE_READ_ALLOWED_TOOLS_JSON='["list_directory","read_file","search_files"]'
REDTEAM_MCP_WORKSPACE_READ_TOOL_OPERATIONS_JSON='{"list_directory":["directory_list"],"read_file":["file_read"],"search_files":["file_search"]}'
REDTEAM_MCP_WORKSPACE_READ_MAX_CONCURRENCY='1'
REDTEAM_MCP_WORKSPACE_READ_MAX_OUTPUT_BYTES='1048576'
