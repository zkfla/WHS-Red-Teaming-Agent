# Optional addition to read.env.example. Operator policy writable=true AND
# Control approval are required. Never disable Control to enable this profile.
REDTEAM_MCP_WORKSPACE_WRITE_KIND='analysis'
REDTEAM_MCP_WORKSPACE_WRITE_TRANSPORT='stdio'
REDTEAM_MCP_WORKSPACE_WRITE_COMMAND='/absolute/path/to/repository/.venv/bin/python'
REDTEAM_MCP_WORKSPACE_WRITE_ARGS_JSON='["-m","redteam.capability.servers.workspace","--policy","/absolute/path/to/workspace-policy.json","--mode","write"]'
REDTEAM_MCP_WORKSPACE_WRITE_PROFILE='workspace_write'
REDTEAM_MCP_WORKSPACE_WRITE_WORKSPACE_ASSET_REF='workspace-demo'
REDTEAM_MCP_WORKSPACE_WRITE_RISK_LEVEL='high'
REDTEAM_MCP_WORKSPACE_WRITE_ALLOWED_TOOLS_JSON='["write_file","apply_patch"]'
REDTEAM_MCP_WORKSPACE_WRITE_TOOL_OPERATIONS_JSON='{"write_file":["file_write"],"apply_patch":["file_edit"]}'
REDTEAM_MCP_WORKSPACE_WRITE_MAX_CONCURRENCY='1'
REDTEAM_MCP_WORKSPACE_WRITE_MAX_OUTPUT_BYTES='1048576'
