# chrome-use must already be installed and connected to its Chrome extension.
# Use a dedicated test profile; never expose a personal banking profile.
REDTEAM_MCP_CHROME_USE_KIND=web_api
REDTEAM_MCP_CHROME_USE_TRANSPORT=stdio
REDTEAM_MCP_CHROME_USE_COMMAND=/absolute/path/to/chrome-use
REDTEAM_MCP_CHROME_USE_ARGS_JSON='["mcp"]'
REDTEAM_MCP_CHROME_USE_RISK_LEVEL=high
REDTEAM_MCP_CHROME_USE_MAX_CONCURRENCY=1
REDTEAM_MCP_CHROME_USE_MAX_OUTPUT_BYTES=1048576
REDTEAM_MCP_CHROME_USE_ALLOWED_TOOLS_JSON='["chrome_use_open","chrome_use_read","chrome_use_snapshot","chrome_use_click","chrome_use_fill","chrome_use_type","chrome_use_press"]'
REDTEAM_MCP_CHROME_USE_TOOL_OPERATIONS_JSON='{"chrome_use_open":["http_request"],"chrome_use_read":["response_analysis"],"chrome_use_snapshot":["response_analysis"],"chrome_use_click":["auth_attempt"],"chrome_use_fill":["auth_attempt"],"chrome_use_type":["auth_attempt"],"chrome_use_press":["auth_attempt"]}'

