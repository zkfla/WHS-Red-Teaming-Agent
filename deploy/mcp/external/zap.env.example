# Official ZAP MCP Integration add-on. Run ZAP on the same operator host.
# In ZAP: Marketplace -> MCP Integration; bind to loopback only.
# The add-on expects the security key as the complete Authorization value.
ZAP_MCP_SECURITY_KEY=replace-with-operator-managed-key

# Use two logical server IDs against the same upstream so recon and intrusive
# web tools retain separate namespaces, risk levels and approvals.
REDTEAM_MCP_ZAP_RECON_KIND=recon
REDTEAM_MCP_ZAP_RECON_TRANSPORT=streamable_http
REDTEAM_MCP_ZAP_RECON_ENDPOINT=http://127.0.0.1:8282
REDTEAM_MCP_ZAP_RECON_AUTHORIZATION_ENV_VAR=ZAP_MCP_SECURITY_KEY
REDTEAM_MCP_ZAP_RECON_RISK_LEVEL=high
REDTEAM_MCP_ZAP_RECON_MAX_CONCURRENCY=1
REDTEAM_MCP_ZAP_RECON_MAX_OUTPUT_BYTES=1048576
REDTEAM_MCP_ZAP_RECON_ALLOWED_TOOLS_JSON='["zap_create_context","zap_start_spider","zap_stop_spider","zap_get_spider_status","zap_start_ajax_spider","zap_stop_ajax_spider","zap_get_ajax_spider_status"]'
REDTEAM_MCP_ZAP_RECON_TOOL_OPERATIONS_JSON='{"zap_create_context":[],"zap_start_spider":["endpoint_discovery"],"zap_stop_spider":[],"zap_get_spider_status":["response_analysis"],"zap_start_ajax_spider":["endpoint_discovery"],"zap_stop_ajax_spider":[],"zap_get_ajax_spider_status":["response_analysis"]}'

REDTEAM_MCP_ZAP_WEB_KIND=web_api
REDTEAM_MCP_ZAP_WEB_TRANSPORT=streamable_http
REDTEAM_MCP_ZAP_WEB_ENDPOINT=http://127.0.0.1:8282
REDTEAM_MCP_ZAP_WEB_AUTHORIZATION_ENV_VAR=ZAP_MCP_SECURITY_KEY
REDTEAM_MCP_ZAP_WEB_RISK_LEVEL=critical
REDTEAM_MCP_ZAP_WEB_MAX_CONCURRENCY=1
REDTEAM_MCP_ZAP_WEB_MAX_OUTPUT_BYTES=1048576
REDTEAM_MCP_ZAP_WEB_ALLOWED_TOOLS_JSON='["zap_start_active_scan","zap_stop_active_scan","zap_get_active_scan_status","zap_get_passive_scan_status","zap_generate_report"]'
REDTEAM_MCP_ZAP_WEB_TOOL_OPERATIONS_JSON='{"zap_start_active_scan":["parameter_fuzz"],"zap_stop_active_scan":[],"zap_get_active_scan_status":["response_analysis"],"zap_get_passive_scan_status":["response_analysis"],"zap_generate_report":["response_analysis"]}'

