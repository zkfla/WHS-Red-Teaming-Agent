# Official PortSwigger MCP extension. Install and enable it inside Burp first.
# Replace both absolute paths. Keep the Burp SSE listener on loopback.
REDTEAM_MCP_BURP_OBSERVE_KIND=web_api
REDTEAM_MCP_BURP_OBSERVE_TRANSPORT=stdio
REDTEAM_MCP_BURP_OBSERVE_COMMAND=/absolute/path/to/burp/java
REDTEAM_MCP_BURP_OBSERVE_ARGS_JSON='["-jar","/absolute/path/to/mcp-proxy-all.jar","--sse-url","http://127.0.0.1:9876"]'
REDTEAM_MCP_BURP_OBSERVE_RISK_LEVEL=medium
REDTEAM_MCP_BURP_OBSERVE_MAX_CONCURRENCY=1
REDTEAM_MCP_BURP_OBSERVE_MAX_OUTPUT_BYTES=1048576
REDTEAM_MCP_BURP_OBSERVE_ALLOWED_TOOLS_JSON='["get_proxy_http_history","get_proxy_http_history_regex","get_proxy_websocket_history","get_proxy_websocket_history_regex"]'
REDTEAM_MCP_BURP_OBSERVE_TOOL_OPERATIONS_JSON='{"get_proxy_http_history":["response_analysis"],"get_proxy_http_history_regex":["response_analysis"],"get_proxy_websocket_history":["response_analysis"],"get_proxy_websocket_history_regex":["response_analysis"]}'

# Optional Burp Professional-only Collaborator profile. Configure this as a
# separate server ID so read-only history does not inherit its high risk tier.
REDTEAM_MCP_BURP_OAST_KIND=web_api
REDTEAM_MCP_BURP_OAST_TRANSPORT=stdio
REDTEAM_MCP_BURP_OAST_COMMAND=/absolute/path/to/burp/java
REDTEAM_MCP_BURP_OAST_ARGS_JSON='["-jar","/absolute/path/to/mcp-proxy-all.jar","--sse-url","http://127.0.0.1:9876"]'
REDTEAM_MCP_BURP_OAST_RISK_LEVEL=high
REDTEAM_MCP_BURP_OAST_MAX_CONCURRENCY=1
REDTEAM_MCP_BURP_OAST_MAX_OUTPUT_BYTES=262144
REDTEAM_MCP_BURP_OAST_ALLOWED_TOOLS_JSON='["generate_collaborator_payload","get_collaborator_interactions"]'
REDTEAM_MCP_BURP_OAST_TOOL_OPERATIONS_JSON='{"generate_collaborator_payload":["parameter_fuzz"],"get_collaborator_interactions":["response_analysis"]}'

