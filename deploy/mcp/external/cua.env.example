# Cua Driver must run on the operator desktop with OS Accessibility and Screen
# Recording grants. Use bounded mode and a reviewed Cua capability manifest.
REDTEAM_MCP_CUA_DRIVER_KIND=web_api
REDTEAM_MCP_CUA_DRIVER_TRANSPORT=stdio
REDTEAM_MCP_CUA_DRIVER_COMMAND=/absolute/path/to/cua-driver
REDTEAM_MCP_CUA_DRIVER_ARGS_JSON='["mcp"]'
REDTEAM_MCP_CUA_DRIVER_RISK_LEVEL=high
REDTEAM_MCP_CUA_DRIVER_MAX_CONCURRENCY=1
REDTEAM_MCP_CUA_DRIVER_MAX_OUTPUT_BYTES=2097152
REDTEAM_MCP_CUA_DRIVER_ALLOWED_TOOLS_JSON='["list_apps","list_windows","get_window_state","click","type_text","press_key"]'
REDTEAM_MCP_CUA_DRIVER_TOOL_OPERATIONS_JSON='{"list_apps":["response_analysis"],"list_windows":["response_analysis"],"get_window_state":["response_analysis"],"click":["auth_attempt"],"type_text":["auth_attempt"],"press_key":["auth_attempt"]}'

