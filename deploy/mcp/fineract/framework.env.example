# stdio MCP server pointed at the self-hosted Fineract (HTTP :8080).
# The CLI spawns it as a child process (no Docker network needed), so the
# whole Agent -> Control -> MCP -> Fineract flow runs from your host CLI.
#
# Source before running (bash/zsh):
#   set -a; . deploy/mcp/fineract/framework.env.example; set +a
#   redteam run examples/fineract-engagement.yaml --config deploy/mcp/fineract/app.yaml --non-interactive
#
# COMMAND and --policy are ABSOLUTE paths. Adjust if your repo is not at
# /root/projects/WHS-Red-Teaming-Agent (run `pwd` and `readlink -f .venv/bin/python`).
REDTEAM_MCP_FINERACT_RECON_KIND=recon
REDTEAM_MCP_FINERACT_RECON_TRANSPORT=stdio
REDTEAM_MCP_FINERACT_RECON_COMMAND=/root/projects/WHS-Red-Teaming-Agent/.venv/bin/python
REDTEAM_MCP_FINERACT_RECON_ARGS_JSON='["-m","redteam.capability.servers","recon-passive","--policy","/root/projects/WHS-Red-Teaming-Agent/deploy/mcp/fineract/policy.json","--transport","stdio"]'
REDTEAM_MCP_FINERACT_RECON_RISK_LEVEL=medium
REDTEAM_MCP_FINERACT_RECON_MAX_CONCURRENCY=1
REDTEAM_MCP_FINERACT_RECON_MAX_OUTPUT_BYTES=262144
REDTEAM_MCP_FINERACT_RECON_ALLOWED_TOOLS_JSON='["dns_resolve","http_probe","tls_inspect","openapi_inventory","oidc_inventory","html_inventory"]'
REDTEAM_MCP_FINERACT_RECON_TOOL_OPERATIONS_JSON='{"dns_resolve":["service_discovery"],"http_probe":["service_discovery"],"tls_inspect":["service_discovery"],"openapi_inventory":["endpoint_discovery"],"oidc_inventory":["endpoint_discovery"],"html_inventory":["endpoint_discovery"]}'

# web-http server (HIGH risk) — lets the agent propose web.http_request against
# Fineract. With the default approval policy + risk threshold=HIGH, our Control
# escalates it to REQUIRE_APPROVAL (human-in-the-loop) instead of executing.
REDTEAM_MCP_FINERACT_WEB_KIND=web_api
REDTEAM_MCP_FINERACT_WEB_TRANSPORT=stdio
REDTEAM_MCP_FINERACT_WEB_COMMAND=/root/projects/WHS-Red-Teaming-Agent/.venv/bin/python
REDTEAM_MCP_FINERACT_WEB_ARGS_JSON='["-m","redteam.capability.servers","web-http","--policy","/root/projects/WHS-Red-Teaming-Agent/deploy/mcp/fineract/policy.json","--transport","stdio"]'
REDTEAM_MCP_FINERACT_WEB_RISK_LEVEL=high
REDTEAM_MCP_FINERACT_WEB_MAX_CONCURRENCY=1
REDTEAM_MCP_FINERACT_WEB_MAX_OUTPUT_BYTES=262144
REDTEAM_MCP_FINERACT_WEB_ALLOWED_TOOLS_JSON='["session_list","http_request","http_compare_sessions","http_security_posture","http_compare_anonymous"]'
REDTEAM_MCP_FINERACT_WEB_TOOL_OPERATIONS_JSON='{"session_list":[],"http_request":["http_request"],"http_compare_sessions":["response_analysis"],"http_security_posture":["response_analysis"],"http_compare_anonymous":["response_analysis"]}'
