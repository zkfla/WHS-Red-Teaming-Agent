{
  "targets": {
    "fineract": {
      "origin": "http://127.0.0.1:18080",
      "allowed_paths": [
        "/",
        "/fineract-provider/actuator/health",
        "/fineract-provider/api/v1/offices",
        "/fineract-provider/api/v1/clients",
        "/fineract-provider/api/v1/roles",
        "/fineract-provider/api/v1/users",
        "/fineract-provider/api/v1/self/clients"
      ],
      "allowed_methods": ["GET", "HEAD", "OPTIONS"],
      "allowed_query_keys": {
        "/fineract-provider/api/v1/offices": ["tenantIdentifier"],
        "/fineract-provider/api/v1/clients": ["tenantIdentifier"],
        "/fineract-provider/api/v1/roles": ["tenantIdentifier"],
        "/fineract-provider/api/v1/users": ["tenantIdentifier"],
        "/fineract-provider/api/v1/self/clients": ["tenantIdentifier"]
      }
    }
  },
  "allowed_networks": ["127.0.0.0/8"],
  "max_response_bytes": 262144,
  "timeout_seconds": 10,
  "active_enabled": false
}
