# Localhost-only MCP endpoints for running the interactive `redteam` CLI on the host.
REDTEAM_MCP_WEB_HTTP_KIND=web_api
REDTEAM_MCP_WEB_HTTP_TRANSPORT=streamable_http
REDTEAM_MCP_WEB_HTTP_ENDPOINT=http://127.0.0.1:18001/mcp
REDTEAM_MCP_WEB_HTTP_ALLOW_INSECURE_HTTP=true
REDTEAM_MCP_WEB_HTTP_RISK_LEVEL=high
REDTEAM_MCP_WEB_HTTP_MAX_CONCURRENCY=1
REDTEAM_MCP_WEB_HTTP_MAX_OUTPUT_BYTES=262144
REDTEAM_MCP_WEB_HTTP_ALLOWED_TOOLS_JSON='["http_request","http_security_posture"]'
REDTEAM_MCP_WEB_HTTP_TOOL_OPERATIONS_JSON='{"http_request":["http_request"],"http_security_posture":["response_analysis"]}'

REDTEAM_MCP_RECON_PASSIVE_KIND=recon
REDTEAM_MCP_RECON_PASSIVE_TRANSPORT=streamable_http
REDTEAM_MCP_RECON_PASSIVE_ENDPOINT=http://127.0.0.1:18002/mcp
REDTEAM_MCP_RECON_PASSIVE_ALLOW_INSECURE_HTTP=true
REDTEAM_MCP_RECON_PASSIVE_RISK_LEVEL=medium
REDTEAM_MCP_RECON_PASSIVE_MAX_CONCURRENCY=1
REDTEAM_MCP_RECON_PASSIVE_MAX_OUTPUT_BYTES=262144
REDTEAM_MCP_RECON_PASSIVE_ALLOWED_TOOLS_JSON='["http_probe"]'
REDTEAM_MCP_RECON_PASSIVE_TOOL_OPERATIONS_JSON='{"http_probe":["service_discovery"]}'

LAB_ALICE_TOKEN=synthetic-alice
LAB_BOB_TOKEN=synthetic-bob
