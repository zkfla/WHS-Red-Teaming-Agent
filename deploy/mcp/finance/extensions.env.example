# Additional servers; use together with framework.env.example.
REDTEAM_MCP_WEB_ZAP_KIND=web_api
REDTEAM_MCP_WEB_ZAP_TRANSPORT=streamable_http
REDTEAM_MCP_WEB_ZAP_ENDPOINT=http://web-zap:8000/mcp
REDTEAM_MCP_WEB_ZAP_ALLOW_INSECURE_HTTP=true
REDTEAM_MCP_WEB_ZAP_MAX_OUTPUT_BYTES=262144
REDTEAM_MCP_WEB_ZAP_ALLOWED_TOOLS_JSON='["zap_capture_snapshot"]'
REDTEAM_MCP_WEB_ZAP_TOOL_OPERATIONS_JSON='{"zap_capture_snapshot":["response_analysis"]}'

REDTEAM_MCP_WEB_NUCLEI_KIND=web_api
REDTEAM_MCP_WEB_NUCLEI_TRANSPORT=streamable_http
REDTEAM_MCP_WEB_NUCLEI_ENDPOINT=http://web-nuclei:8000/mcp
REDTEAM_MCP_WEB_NUCLEI_ALLOW_INSECURE_HTTP=true
REDTEAM_MCP_WEB_NUCLEI_MAX_OUTPUT_BYTES=262144
REDTEAM_MCP_WEB_NUCLEI_ALLOWED_TOOLS_JSON='["nuclei_response_check"]'
REDTEAM_MCP_WEB_NUCLEI_TOOL_OPERATIONS_JSON='{"nuclei_response_check":["response_analysis"]}'
