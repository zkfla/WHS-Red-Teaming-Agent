# Host-side MCP endpoints (loopback published ports; see finance-lab.host-ports.yml).
# Used by the smoke runner INSIDE the isolated Compose network.
# No MCP port is published to the host or public network.
REDTEAM_MCP_WEB_HTTP_KIND=web_api
REDTEAM_MCP_WEB_HTTP_TRANSPORT=streamable_http
REDTEAM_MCP_WEB_HTTP_ENDPOINT=http://127.0.0.1:8010/mcp
REDTEAM_MCP_WEB_HTTP_ALLOW_INSECURE_HTTP=true
REDTEAM_MCP_WEB_HTTP_RISK_LEVEL=high
REDTEAM_MCP_WEB_HTTP_MAX_CONCURRENCY=1
REDTEAM_MCP_WEB_HTTP_MAX_OUTPUT_BYTES=262144
REDTEAM_MCP_WEB_HTTP_ALLOWED_TOOLS_JSON='["session_list","http_request","http_compare_sessions","http_security_posture","http_compare_anonymous"]'
REDTEAM_MCP_WEB_HTTP_TOOL_OPERATIONS_JSON='{"session_list":["response_analysis"],"http_request":["http_request"],"http_compare_sessions":["response_analysis"],"http_security_posture":["response_analysis"],"http_compare_anonymous":["response_analysis"]}'

REDTEAM_MCP_WEB_PROXY_KIND=web_api
REDTEAM_MCP_WEB_PROXY_TRANSPORT=streamable_http
REDTEAM_MCP_WEB_PROXY_ENDPOINT=http://127.0.0.1:8011/mcp
REDTEAM_MCP_WEB_PROXY_ALLOW_INSECURE_HTTP=true
REDTEAM_MCP_WEB_PROXY_RISK_LEVEL=high
REDTEAM_MCP_WEB_PROXY_MAX_CONCURRENCY=1
REDTEAM_MCP_WEB_PROXY_MAX_OUTPUT_BYTES=262144
REDTEAM_MCP_WEB_PROXY_ALLOWED_TOOLS_JSON='["proxy_status","proxy_list_flows","proxy_get_flow","proxy_reload_capture","proxy_replay_flow","proxy_mutate_json","proxy_compare_sessions"]'
REDTEAM_MCP_WEB_PROXY_TOOL_OPERATIONS_JSON='{"proxy_status":["response_analysis"],"proxy_list_flows":["response_analysis"],"proxy_get_flow":["response_analysis"],"proxy_reload_capture":[],"proxy_replay_flow":["http_request"],"proxy_mutate_json":["parameter_fuzz"],"proxy_compare_sessions":["response_analysis"]}'

REDTEAM_MCP_WEB_BROWSER_KIND=web_api
REDTEAM_MCP_WEB_BROWSER_TRANSPORT=streamable_http
REDTEAM_MCP_WEB_BROWSER_ENDPOINT=http://127.0.0.1:8012/mcp
REDTEAM_MCP_WEB_BROWSER_ALLOW_INSECURE_HTTP=true
REDTEAM_MCP_WEB_BROWSER_RISK_LEVEL=high
REDTEAM_MCP_WEB_BROWSER_MAX_CONCURRENCY=1
REDTEAM_MCP_WEB_BROWSER_MAX_OUTPUT_BYTES=1048576
REDTEAM_MCP_WEB_BROWSER_ALLOWED_TOOLS_JSON='["browser_navigate","browser_snapshot","browser_click","browser_fill_form","browser_close"]'
REDTEAM_MCP_WEB_BROWSER_TOOL_OPERATIONS_JSON='{"browser_navigate":["http_request"],"browser_snapshot":["response_analysis"],"browser_click":["auth_attempt"],"browser_fill_form":["auth_attempt"],"browser_close":[]}'

REDTEAM_MCP_RECON_PASSIVE_KIND=recon
REDTEAM_MCP_RECON_PASSIVE_TRANSPORT=streamable_http
REDTEAM_MCP_RECON_PASSIVE_ENDPOINT=http://127.0.0.1:8013/mcp
REDTEAM_MCP_RECON_PASSIVE_ALLOW_INSECURE_HTTP=true
REDTEAM_MCP_RECON_PASSIVE_RISK_LEVEL=medium
REDTEAM_MCP_RECON_PASSIVE_MAX_CONCURRENCY=1
REDTEAM_MCP_RECON_PASSIVE_MAX_OUTPUT_BYTES=262144
REDTEAM_MCP_RECON_PASSIVE_ALLOWED_TOOLS_JSON='["dns_resolve","http_probe","tls_inspect","openapi_inventory","oidc_inventory","html_inventory"]'
REDTEAM_MCP_RECON_PASSIVE_TOOL_OPERATIONS_JSON='{"dns_resolve":["service_discovery"],"http_probe":["service_discovery"],"tls_inspect":["service_discovery"],"openapi_inventory":["endpoint_discovery"],"oidc_inventory":["endpoint_discovery"],"html_inventory":["endpoint_discovery"]}'

REDTEAM_MCP_RECON_ACTIVE_KIND=recon
REDTEAM_MCP_RECON_ACTIVE_TRANSPORT=streamable_http
REDTEAM_MCP_RECON_ACTIVE_ENDPOINT=http://127.0.0.1:8014/mcp
REDTEAM_MCP_RECON_ACTIVE_ALLOW_INSECURE_HTTP=true
REDTEAM_MCP_RECON_ACTIVE_RISK_LEVEL=high
REDTEAM_MCP_RECON_ACTIVE_MAX_CONCURRENCY=1
REDTEAM_MCP_RECON_ACTIVE_MAX_OUTPUT_BYTES=262144
REDTEAM_MCP_RECON_ACTIVE_ALLOWED_TOOLS_JSON='["active_status","port_scan"]'
REDTEAM_MCP_RECON_ACTIVE_TOOL_OPERATIONS_JSON='{"active_status":[],"port_scan":["port_scan"]}'
