# Copy to .env and fill in. Nothing here is loaded automatically yet —
# app/bootstrap.py is the place that will read these once real backends
# (LiteLLM providers, MCP server endpoints) are wired in.

# --- LLM (LiteLLM) ---
# Any provider LiteLLM supports; see redteam/llm/litellm.py
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# --- MCP example server (deploy/compose) ---
MCP_EXAMPLE_HOST=localhost
MCP_EXAMPLE_PORT=8765

# --- Engagement defaults ---
REDTEAM_LOG_LEVEL=INFO
