# Copy to .env in the directory you run `redteam` from. `redteam` loads a
# `.env` there into its own process environment automatically at startup
# (best-effort; a real shell/CI-exported variable always wins over a .env
# value -- see `_shared.load_dotenv_if_present`), so a plain `export`/
# `source` step is optional, not required. Secrets are referenced by
# environment-variable name and are never placed in AppConfig.
#
# These are read directly by `redteam run engagement.yaml` / `redteam` /
# `redteam tools list` (LLMConfig.from_environment,
# capability.settings.mcp_server_ids_from_environment) -- there is no
# application-config YAML file or `--config` flag in this CLI.

# --- LLM ---
# Unset (or REDTEAM_LLM_PROVIDER=fake) keeps the explicit, offline
# FakeLLMClient -- never silently "upgraded" to a real provider and never
# silently downgraded from a typo either (an unrecognized provider name
# is a startup error, not a quiet fallback to fake).
REDTEAM_LLM_PROVIDER=litellm
# Any provider LiteLLM supports; see redteam/llm/litellm.py
REDTEAM_LLM_MODEL=gpt-4o-mini
# Name of the env var holding the API key (the key itself is never put in
# a config file); defaults to LLM_API_KEY if unset.
REDTEAM_LLM_API_KEY_ENV_VAR=LLM_API_KEY
LLM_API_KEY=

# --- MCP servers ---
# Comma-separated server ids to activate; each one still needs its own
# REDTEAM_MCP_<ID>_* connection settings below. Unset/empty means no MCP
# server at all -- an honest empty tool catalog, never a substitute tool.
REDTEAM_MCP_SERVERS=web-example
# The literal value "example" (REDTEAM_MCP_SERVERS=example) instead
# requests the harmless in-process ExampleMCPAdapter test/dev fixture --
# never chosen automatically, see redteam/app/bootstrap.py's
# EXAMPLE_MCP_SENTINEL.

# --- MCP example server (deploy/compose) ---
MCP_EXAMPLE_PORT=8765

# With "web-example" in REDTEAM_MCP_SERVERS, set:
REDTEAM_MCP_WEB_EXAMPLE_KIND=web_api
REDTEAM_MCP_WEB_EXAMPLE_TRANSPORT=streamable_http
REDTEAM_MCP_WEB_EXAMPLE_ENDPOINT=http://127.0.0.1:8765/mcp
REDTEAM_MCP_WEB_EXAMPLE_RISK_LEVEL=low
REDTEAM_MCP_WEB_EXAMPLE_MAX_CONCURRENCY=1
REDTEAM_MCP_WEB_EXAMPLE_MAX_OUTPUT_BYTES=1048576

# Optional authentication. The first variable names the secret variable;
# the second is the local placeholder for that secret.
REDTEAM_MCP_WEB_EXAMPLE_TOKEN_ENV_VAR=MCP_WEB_EXAMPLE_TOKEN
MCP_WEB_EXAMPLE_TOKEN=

# Local stdio example (uncomment and use "analysis-local" as a server ID):
# see "Local fallback MCP server (analysis-local)" below for the concrete,
# committed implementation of this same pattern.

# --- Mobile capability: candidate external MCP server ---
# NOT finalized (see deploy/mcp/README.md "Mobile capability"). Uncomment
# and add "mobile-next" to capability.mcp_servers to enable. Swapping this
# for another mobile MCP server needs no code change, only these settings.
# Streamable HTTP, via `deploy/compose/docker-compose.yml` profile "mobile"
# (mobile-next/mobile-mcp `--listen`, requires host ADB/simulator access):
# REDTEAM_MCP_MOBILE_NEXT_KIND=mobile
# REDTEAM_MCP_MOBILE_NEXT_TRANSPORT=streamable_http
# REDTEAM_MCP_MOBILE_NEXT_ENDPOINT=http://127.0.0.1:3000/mcp
# REDTEAM_MCP_MOBILE_NEXT_RISK_LEVEL=medium
# REDTEAM_MCP_MOBILE_NEXT_ALLOWED_TOOLS_JSON=["mobile_launch_app","mobile_get_device_logs","mobile_list_crashes","mobile_get_crash"]
# REDTEAM_MCP_MOBILE_NEXT_TOOL_OPERATIONS_JSON={"mobile_launch_app":["app_launch"],"mobile_get_device_logs":["response_analysis"],"mobile_list_crashes":["response_analysis"],"mobile_get_crash":["response_analysis"]}
#
# Stdio alternative (upstream default; runs on the host with ADB/Xcode
# tooling already set up — no --listen flag needed):
# REDTEAM_MCP_MOBILE_NEXT_TRANSPORT=stdio
# REDTEAM_MCP_MOBILE_NEXT_COMMAND=npx
# REDTEAM_MCP_MOBILE_NEXT_ARGS_JSON=["-y","@mobilenext/mobile-mcp@1.0.4"]
# REDTEAM_MCP_MOBILE_NEXT_PASSTHROUGH_ENV=ANDROID_HOME,ANDROID_SERIAL,PATH,MOBILECLI_HOME
# MOBILECLI_HOME=C:/short/writable/mobilecli-state
#
# device_shell is not covered by mobile-next/mobile-mcp; the in-repo
# fallback (redteam.capability.servers.mobile) fills that gap — see
# "Local fallback MCP server (mobile-local)" below.

# Local fallback MCP server (mobile-local): allowlisted ADB diagnostics
# only (no UI automation, no arbitrary shell). Policy JSON shape is
# {"devices": {"<ref>": {"serial": "..."}}, "allowed_commands": [...]}
# (see src/redteam/capability/servers/mobile.py).
# REDTEAM_MCP_MOBILE_LOCAL_KIND=mobile
# REDTEAM_MCP_MOBILE_LOCAL_TRANSPORT=stdio
# REDTEAM_MCP_MOBILE_LOCAL_COMMAND=/absolute/path/to/python
# REDTEAM_MCP_MOBILE_LOCAL_ARGS_JSON=["-m","redteam.capability.servers.mobile","--policy","/absolute/path/to/mobile-policy.json"]
# REDTEAM_MCP_MOBILE_LOCAL_ALLOWED_TOOLS_JSON=["device_shell"]
# REDTEAM_MCP_MOBILE_LOCAL_TOOL_OPERATIONS_JSON={"device_shell":["device_shell"]}

# --- Analysis capability: candidate external MCP server ---
# NOT finalized (see deploy/mcp/README.md "Analysis capability"). Uncomment
# and add "apktool" to capability.mcp_servers to enable. Only read/analyze
# tools are allowlisted; build/modify/clean are intentionally excluded.
# Stdio only (upstream apktool-mcp-server has no HTTP mode). Run directly
# on a host with apktool + uv installed, or via
# `docker compose run --rm -i apktool-mcp` (profile "tools").
# REDTEAM_MCP_APKTOOL_KIND=analysis
# REDTEAM_MCP_APKTOOL_TRANSPORT=stdio
# REDTEAM_MCP_APKTOOL_COMMAND=uv
# REDTEAM_MCP_APKTOOL_ARGS_JSON=["--directory","/absolute/path/to/apktool-mcp-server","run","apktool_mcp_server.py"]
# REDTEAM_MCP_APKTOOL_RISK_LEVEL=low
# REDTEAM_MCP_APKTOOL_ALLOWED_TOOLS_JSON=["decode_apk","get_manifest","get_apktool_yml","list_smali_directories","list_smali_files","get_smali_file","list_resources","get_resource_file","search_in_files"]
# REDTEAM_MCP_APKTOOL_TOOL_OPERATIONS_JSON={"decode_apk":["static_analysis"],"get_manifest":["static_analysis"],"get_apktool_yml":["static_analysis"],"list_smali_directories":["static_analysis"],"list_smali_files":["static_analysis"],"get_smali_file":["static_analysis"],"list_resources":["static_analysis"],"get_resource_file":["static_analysis"],"search_in_files":["static_analysis"]}

# Local fallback MCP server (analysis-local): zip-container-level APK
# inventory, no apktool/Java dependency. Policy JSON shape is
# {"apks": {"<ref>": {"path": "/abs/path/app.apk"}}} (see
# src/redteam/capability/servers/analysis.py).
# REDTEAM_MCP_ANALYSIS_LOCAL_KIND=analysis
# REDTEAM_MCP_ANALYSIS_LOCAL_TRANSPORT=stdio
# REDTEAM_MCP_ANALYSIS_LOCAL_COMMAND=/absolute/path/to/python
# REDTEAM_MCP_ANALYSIS_LOCAL_ARGS_JSON=["-m","redteam.capability.servers.analysis","--policy","/absolute/path/to/analysis-policy.json"]
# REDTEAM_MCP_ANALYSIS_LOCAL_TOOL_OPERATIONS_JSON={"apk_file_listing":["static_analysis"],"apk_entry_digest":["static_analysis"],"apk_string_search":["static_analysis"]}

# --- Analysis capability: candidate external MCP server (jadx) ---
# NOT finalized (see deploy/mcp/README.md "Analysis capability"). Java-level
# decompilation via zinja-coder/jadx-mcp-server, same canonical op as apktool
# for candidate diversification. Only read-only decompilation queries are
# allowlisted; rename_*/add_comment/clear_cache (state-changing) are excluded.
# Requires a running jadx-gui with the jadx-ai-mcp plugin (HTTP on 127.0.0.1:8650)
# and an APK loaded; jadx_mcp_server.py bridges MCP stdio -> that plugin.
# REDTEAM_MCP_JADX_KIND=analysis
# REDTEAM_MCP_JADX_TRANSPORT=stdio
# REDTEAM_MCP_JADX_COMMAND=uv
# REDTEAM_MCP_JADX_ARGS_JSON=["--directory","/absolute/path/to/jadx-mcp-server","run","jadx_mcp_server.py"]
# REDTEAM_MCP_JADX_RISK_LEVEL=low
# REDTEAM_MCP_JADX_ALLOWED_TOOLS_JSON=["get_all_classes","get_class_source","get_methods_of_class","get_fields_of_class","search_method_by_name","search_classes_by_keyword","get_android_manifest","get_strings","get_xrefs_to_method"]
# REDTEAM_MCP_JADX_TOOL_OPERATIONS_JSON={"get_all_classes":["static_analysis"],"get_class_source":["static_analysis"],"get_methods_of_class":["static_analysis"],"get_fields_of_class":["static_analysis"],"search_method_by_name":["static_analysis"],"search_classes_by_keyword":["static_analysis"],"get_android_manifest":["static_analysis"],"get_strings":["static_analysis"],"get_xrefs_to_method":["static_analysis"]}

# --- Engagement defaults ---
REDTEAM_LOG_LEVEL=INFO
